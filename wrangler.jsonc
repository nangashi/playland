{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playland",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-15",
  // 画面・API・写真のすべてを Worker で認証してから返す（静的アセットを Worker より先に配信させない）
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // 公開 URL は workers.dev。Worker 単位の Cloudflare Access で保護する（docs/production.md）。
  // Worker 側でも Access の検証を行い、設定が欠けていれば全部拒否する。プレビュー URL は使わない
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "playland",
      // 本番の ID は Cloudflare 側で作成後に設定する。ローカル開発では使われない
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 写真。公開 URL（r2.dev・カスタムドメイン）は有効にせず、GET /media/:id からだけ返す
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "playland-media"
    }
  ],
  // 秘密情報は wrangler secret put で設定する（Git に置かない）:
  //   PARENT_PIN（4〜12桁の数字）, ADMIN_SESSION_SECRET（32文字以上）
  "vars": {
    // "access"：Cloudflare Access の JWT を検証する（本番）
    // "dev-mock"：localhost からのリクエストに限り認証を省略する（.dev.vars で上書き）
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
